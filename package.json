{
  "name": "ntnyq",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "run-s format:check lint typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "start": "tsx scripts/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "consola": "^3.4.2",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "ofetch": "^1.5.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.22.0"
}
